# Variables de la aplicacion Laravel. En Docker, la conexion a la base la define docker-compose.yml.
APP_NAME=GestorDep
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_ZONA_PRESENTACION=America/Mexico_City

DB_CONNECTION=pgsql
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Dominios con cookies de sesion (Sanctum SPA). 8000 es el puerto del servidor de desarrollo (servicio web, PT-09); 8099, el de los guiones de humo.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,localhost:8099,127.0.0.1,127.0.0.1:8000,127.0.0.1:8099
