# Variables del entorno de Docker Compose (desarrollo).
# Copiar a .env: cp .env.example .env
# Las claves de abajo son SOLO de prueba para desarrollo local; nunca se usan fuera de el.

# Puerto del anfitrion para PostgreSQL. 5433 evita chocar con un PostgreSQL local en 5432.
DB_PUERTO_ANFITRION=5433

# Bases de datos
DB_DATABASE=gestordep
DB_DATABASE_PRUEBAS=gestordep_pruebas

# Superusuario del contenedor (solo lo usa el script de inicializacion)
DB_SUPERUSUARIO_CLAVE=clave_superusuario_solo_desarrollo

# Rol propietario: ejecuta las migraciones
DB_PROPIETARIO=gestordep_propietario
DB_PROPIETARIO_CLAVE=clave_propietario_solo_desarrollo

# Rol de aplicacion: lo usa la aplicacion en ejecucion; sin UPDATE ni DELETE en tablas *_historial (T08)
DB_USERNAME=gestordep_app
DB_PASSWORD=clave_aplicacion_solo_desarrollo
